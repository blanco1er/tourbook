# Copy to .env (never commit .env). Everything is optional: with no keys the app runs fully in MOCK mode.

PORT=8787

# --- Qloo ---------------------------------------------------------------
# mock | live   (default: live if QLOO_API_KEY is set, otherwise mock)
QLOO_MODE=mock
QLOO_API_KEY=
# Hackathon developer guide: hackathon keys only work on this host (they 401 on api.qloo.com).
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Private on-disk cache of Qloo responses (gitignored, no TTL).
QLOO_CACHE_DIR=.cache/qloo
QLOO_MAX_CONCURRENCY=4
QLOO_MIN_INTERVAL_MS=150
QLOO_TIMEOUT_MS=20000
QLOO_MAX_ATTEMPTS=3
# true = refuse to send a parameter that is not documented for that filter.type (Qloo ignores them silently).
QLOO_STRICT_PARAMS=true
# auto | heatmap_national | heatmap_city | artist_in_city | places_in_city
MARKET_STRATEGY=auto
# Optional heatmap output boundary (empty = Qloo default geohash grid). Example: urn:entity:locality
HEATMAP_BOUNDARY=

# --- LLM (OpenAI-compatible chat/completions with tools) -------------------
# mock | openai   (default: openai if LLM_API_KEY is set, otherwise mock)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_STEPS=40

# --- Guardrails ----------------------------------------------------------
RUNS_PER_IP_PER_DAY=30
